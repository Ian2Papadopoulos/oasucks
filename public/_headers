# Response headers for the static files, applied by Cloudflare's asset
# server. This file is configuration, not content — it is not served.
#
# NOTE: this is the belt, not the braces. What actually stops a phone
# showing "not secure" is the edge redirecting http:// to https://, which
# is a dashboard setting (SSL/TLS → Edge Certificates → Always Use HTTPS).
# HSTS below only helps on the SECOND and later visits, because the first
# one is what teaches the browser the rule.

/*
  # One year. No includeSubDomains and no preload on purpose: both are
  # very hard to undo, and a subdomain added later without TLS would
  # simply stop working with no obvious cause.
  Strict-Transport-Security: max-age=31536000
  # Don't let a browser guess a type we didn't send.
  X-Content-Type-Options: nosniff
  # Nothing here should ever be framed by another site.
  X-Frame-Options: DENY
  # Send the origin to third parties (tiles, geocoders), never the path.
  Referrer-Policy: strict-origin-when-cross-origin
  # The app asks for location itself; nothing embedded in it should.
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  # Since v77 the browser talks to exactly one host — this one. The
  # geocoder, the reverse geocoder and the OASA proxy all go through the
  # Worker, and the public-CORS-proxy fallback that used to bypass it is
  # gone. So connect-src can be closed, which is the half of a CSP that
  # actually matters here: it means injected script cannot exfiltrate
  # anything, whatever else it manages to do.
  #
  # script-src keeps 'unsafe-inline' because the app IS one inline script
  # — an honest limitation, not an oversight. Moving it to a file would
  # buy a nonce, and cost the single-file property the whole project is
  # built on. img-src carries the tile hosts and data:/blob: for the
  # canvas-drawn markers.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://tile.openstreetmap.org; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'

